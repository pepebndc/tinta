{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tinta",
  "version": "0.3.0",
  "identifier": "app.tinta",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Tinta",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "resources": {
      "../../extension/*.json": "extension/",
      "../../extension/*.js": "extension/",
      "../../extension/*.html": "extension/",
      "../../extension/*.css": "extension/",
      "../../extension/icons/*": "extension/icons/"
    },
    "externalBin":["binaries/tinta-engine", "binaries/tinta-mcp", "binaries/tinta-native-host"],
    "copyright": "Copyright 2026 The Tinta authors. Apache-2.0.",
    "category": "Productivity",
    "shortDescription": "Meeting notes. On your Mac.",
    "macOS": {
      "minimumSystemVersion": "14.2",
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    }
  }
}
